
def vigenere(text, key):
    result = ""
    key = key.upper()
    j = 0
    for ch in text.upper():
        if ch.isalpha():
            result += chr((ord(ch)-65 + ord(key[j % len(key)])-65) % 26 + 65)
            j += 1
        else:
            result += ch
    return result

print("Encrypted:", vigenere("HELLO", "KEY"))
